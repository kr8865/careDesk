# Server
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas
# Atlas → your cluster → Connect → Drivers → copy the connection string.
# Replace <db_username> and <db_password>, and put the database name (healthcare_db) after ".net/".
# If the password has special characters (@ : / ? # %), URL-encode them (e.g. @ → %40).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-name>.xxxxx.mongodb.net/healthcare_db?retryWrites=true&w=majority&appName=<cluster-name>

# JWT (use long random strings; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
