            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi Kumar\",\n  \"age\": 45,\n  \"gender\": \"male\",\n  \"phone\": \"+91 9876543210\",\n  \"email\": \"ravi@example.com\",\n  \"address\": \"Noida\",\n  \"medicalHistory\": \"Type 2 diabetes\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json(); if (d.patient) pm.collectionVariables.set('patientId', d.patient.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List my patients",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/patients/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Get patient",
          "request": {
            "method": "GET",
